generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Camper {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  descriptionEs String    @db.Text
  descriptionEn String    @db.Text
  features      Json
  images        String[]
  pricePerDay   Int
  pricePerWeek  Int
  pricePerMonth Int
  active        Boolean   @default(true)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id            String        @id @default(cuid())
  camper        Camper        @relation(fields: [camperId], references: [id])
  camperId      String
  startDate     DateTime
  endDate       DateTime
  totalPrice    Int
  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod
  paymentId     String?
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    String
  source        BookingSource @default(PUBLIC)
  notes         String?       @db.Text
  transactions  PaymentTransaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  phone     String
  dni       String?
  license   String?
  bookings  Booking[]
  transactions PaymentTransaction[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  camperId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([camperId, date])
}

model PaymentTransaction {
  id            String            @id @default(cuid())
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  type          TransactionType
  status        TransactionStatus @default(SUCCEEDED)
  paymentMethod PaymentMethod
  amount        Int
  reference     String?
  description   String?           @db.Text
  createdAt     DateTime          @default(now())

  @@index([bookingId, createdAt])
  @@index([customerId, createdAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH
  MANUAL
}

enum BookingSource {
  PUBLIC
  ADMIN
}

enum TransactionType {
  CHARGE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}
